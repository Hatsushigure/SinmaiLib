+                new() { ItemKind = ItemKind.Ticket, ItemId = 42, Stock = 0, IsValid = false },
+            ],
+        };
+
+        var items = response.ToUserItemVOArray();
+
+        Assert.Equal(new[] { 42, 7, 42 }, items.Select(item => item.ItemId));
