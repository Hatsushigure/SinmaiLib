+using System;
+using System.Collections.Generic;
+using System.Linq;
+using Net.VO;
+using Net.VO.Mai2;
+
+namespace Net.Packet.Mai2;
+
+internal class PacketGetUserLoginBonus : Packet
+{
+    private readonly Action<Net.VO.Mai2.UserLoginBonus[]> _onDone;
+    private readonly Action<PacketStatus>? _onError;
+    private readonly List<UserLoginBonusResponseVO> _responseVOList = [];
+
+    public PacketGetUserLoginBonus(
+        ulong userId,
+        Action<Net.VO.Mai2.UserLoginBonus[]> onDone,
+        Action<PacketStatus>? onError = null
+    )
+    {
+        _onDone = onDone;
+        _onError = onError;
+        ResetRetryCountAtStart();
+        Create(GetNetQuery(userId, 0L));
+    }
+
+    public override PacketState Proc()
+    {
+        switch (ProcImpl())
+        {
+            case PacketState.Done:
+            {
+                if (IsRetryCountOverAtDownload())
+                {
+                    AddUserDataDownloadError();
+                    _onError?.Invoke(PacketStatus.ErrorTimeout);
+                    break;
+                }
+                var netQuery = (NetQuery<UserLoginBonusRequestVO, UserLoginBonusResponseVO>)Query;
+                _responseVOList.Add(netQuery.Response!);
+                if (netQuery.Response!.NextIndex != 0L)
+                {
+                    Create(GetNetQuery(netQuery.Response.UserId, netQuery.Response.NextIndex));
+                    break;
+                }
+                _onDone([.. _responseVOList.SelectMany(i => i.UserLoginBonusList)]);
+                break;
+            }
+            case PacketState.Error:
+                _onError?.Invoke(Status);
+                break;
+            case PacketState.Ready:
+            case PacketState.Process:
+            case PacketState.RetryWait:
+            case PacketState.Dialog:
+                break;
+            default:
+                throw new ArgumentOutOfRangeException();
+        }
+        return State;
+    }
+
+    private static NetQuery<UserLoginBonusRequestVO, UserLoginBonusResponseVO> GetNetQuery(
+        ulong userId,
+        long nextIndex
+    ) =>
+        new("GetUserLoginBonusApi", userId)
+        {
+            Request = new UserLoginBonusRequestVO { UserId = userId, NextIndex = nextIndex },
+        };
+}
