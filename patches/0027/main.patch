+using System;
+using Net.VO;
+using Net.VO.Mai2;
+using Net.VO.Mapper;
+
+namespace Net.Packet.Mai2;
+
+internal class PacketGetUserMissionData : Packet
+{
+    private readonly Action<UserMissionResponseData> _onDone;
+    private readonly Action<PacketStatus>? _onError;
+
+    public PacketGetUserMissionData(
+        ulong userId,
+        Action<UserMissionResponseData> onDone,
+        Action<PacketStatus>? onError = null
+    )
+    {
+        _onDone = onDone;
+        _onError = onError;
+        var netQuery = new NetQuery<UserMissionRequestVO, UserMissionResponseVO>(
+            "GetUserMissionDataApi",
+            userId
+        )
+        {
+            Request = new UserMissionRequestVO { UserId = userId },
+        };
+        Create(netQuery);
+    }
+
+    public override PacketState Proc()
+    {
+        switch (ProcImpl())
+        {
+            case PacketState.Done:
+            {
+                var netQuery = (NetQuery<UserMissionRequestVO, UserMissionResponseVO>)Query;
+                _onDone(netQuery.Response!.ToResponseDataVO());
+                break;
+            }
+            case PacketState.Error:
+                _onError?.Invoke(Status);
+                break;
+            case PacketState.Ready:
+            case PacketState.Process:
+            case PacketState.RetryWait:
+            case PacketState.Dialog:
+                break;
+            default:
+                throw new ArgumentOutOfRangeException();
+        }
+        return State;
+    }
+}
