Subject: [PATCH] fix(SpecialNum): Remove detections in SpecialNum generation

- Now use `0x400` directly

diff --git a/src/SinmaiLib/Manager/GameManager.cs b/src/SinmaiLib/Manager/GameManager.cs
index ee7d5a0..4beaf8c 100644
--- a/src/SinmaiLib/Manager/GameManager.cs
+++ b/src/SinmaiLib/Manager/GameManager.cs
@@ -330,58 +330,6 @@ public static void ClearSpecial()
         SpecialAP = false;
     }
 
-    public static int CalcSpecialNum()
-    {
-        int mouse = 0;
-        int keyboard = 0;
-        int hid = 0;
-        Win32.getRawInputDeviceCount(out mouse, out keyboard, out hid);
-        int num = 0;
-        if (SpecialAP)
-        {
-            num |= 1;
-        }
-        if (IsAutoPlay())
-        {
-            num |= 2;
-        }
-        if (keyboard > 0)
-        {
-            num |= 4;
-        }
-        if (mouse > 0)
-        {
-            num |= 8;
-        }
-        if (
-            Singleton<SystemConfig>.Instance.config.IsAutoPlay
-            || Singleton<SystemConfig>.Instance.config.IsDebugDisp
-            || Singleton<SystemConfig>.Instance.config.IsAllOpen
-        )
-        {
-            num |= 0x10;
-        }
-        if (AMDaemon.System.IsDevelop)
-        {
-            num |= 0x20;
-        }
-        if (!SystemInfo.deviceName.Contains("ACA"))
-        {
-            num |= 0x40;
-        }
-        if (!SystemInfo.graphicsDeviceName.Contains("GeForce GTX"))
-        {
-            num |= 0x80;
-        }
-        if (!SystemInfo.processorType.Contains("Core(TM) i3-8100"))
-        {
-            num |= 0x100;
-        }
-        num |= 0x400;
-        UnityEngine.Debug.LogWarning("SpecialNum:" + num + "," + Convert.ToString(num, 2));
-        return num;
-    }
