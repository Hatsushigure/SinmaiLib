+using System;
+using System.Net;
+using System.Net.Http;
+using System.Net.Http.Json;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using System.Text.RegularExpressions;
+
+namespace ChimeLib.NET.COMM;
+
+internal partial class CCommGetUserData : IDisposable
+{
+    private CCommGetUserDataImpl? _instance;
+
+    internal uint UserId => _instance?.UserId ?? 0;
+
+    internal string Token => _instance?.Token ?? string.Empty;
+
+    internal bool IsEnd => _instance?.IsEnd ?? false;
+
+    internal CCommGetUserData(
+        string strGameId,
+        string strChipId,
+        string strCommonKey,
+        string strQrData,
+        string strTitleKey,
+        ulong serverUrlIndex
+    ) => Create(strGameId, strChipId, strCommonKey, strQrData, strTitleKey, serverUrlIndex);
+
+    public void Dispose()
+    {
+        Destroy();
+    }
+
+    private void Create(
+        string strGameId,
+        string strChipId,
+        string _, //Unused `strCommonKey`
+        string strQrData,
+        string strTitleKey,
+        ulong serverUrlIndex
+    )
+    {
+        if (_instance?.Disposed == false)
+        {
+            Destroy();
+        }
+
+        _instance = new()
+        {
+            GameId = strGameId,
+            ChipId = strChipId,
+            QrData = strQrData,
+            TitleKey = strTitleKey,
+            ServerUrlIndex = serverUrlIndex,
+        };
+    }
+
+    private void Destroy()
+    {
+        _instance?.Dispose();
+        _instance = null;
+    }
+
+    internal ChimeErrorId GetErrorId() => _instance?.ErrorId ?? ChimeErrorId.None;
+
+    internal void Execute() => _instance?.Execute();
+
+    private sealed partial class CCommGetUserDataImpl : IDisposable
+    {
+        private const string FIXED_COMMON_KEY = "XcW5FW4cPArBXEk4vzKz3CIrMuA5EVVW";
+        private const string ENDPOINT = "wc_aime/api/get_data";
+        private static readonly TimeSpan TIMEOUT = TimeSpan.FromSeconds(15);
+        private static readonly string[] SERVER_URL_LIST =
+        [
+            "https://ai.sys-allnet.cn/",
+            "https://ai.sys-all.cn/",
+        ];
+
+        private readonly CCommHttpClient _client = new();
+        private State _state = State.START;
+        private long _lastRequestTimestamp;
+
+        public required string GameId { get; init; }
+
+        public required string ChipId { get; init; }
+
+        public string CommonKey { get; } = FIXED_COMMON_KEY;
+
+        public required string QrData { get; init; }
+
+        public required string TitleKey { get; init; }
+
+        public required ulong ServerUrlIndex { get; init; }
+
+        public ChimeErrorId ErrorId { get; private set; } = ChimeErrorId.None;
+
+        public uint UserId { get; private set; }
+
+        public string Token { get; private set; } = string.Empty;
+
+        public bool Disposed { get; private set; }
+
+        public bool IsEnd => _state == State.END;
+
+        public void Execute()
+        {
+            switch (_state)
+            {
+                case State.START:
+                {
+                    var timestampStr = DateTime.Now.ToString("yyMMddHHmmss");
+                    var validateSource = new UTF8Encoding().GetBytes(
+                        $"{ChipId}{timestampStr}{CommonKey}"
+                    );
+                    var validateKey = Convert.ToHexString(SHA256.HashData(validateSource));
+                    var requestBody = JsonSerializer.Serialize(
+                        new()
+                        {
+                            ChipId = ChipId,
+                            Key = validateKey,
+                            OpenGameId = GameId,
+                            QrCode = QrData,
+                            Timestamp = timestampStr,
+                            TitleKey = TitleKey,
+                        },
+                        CCommJsonContext.Default.GetUserDataRequest
+                    );
+                    _client.OpenSession();
+                    var serverUrlIndex = ServerUrlIndex == ulong.MaxValue ? 0 : ServerUrlIndex;
+                    _client.SendRequest(
+                        SERVER_URL_LIST[serverUrlIndex] + ENDPOINT,
+                        new UTF8Encoding().GetBytes(requestBody)
+                    );
+                    _lastRequestTimestamp = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
+                    _state = State.WAITING;
+                    break;
+                }
+                case State.WAITING:
+                {
+                    UserId = uint.MaxValue;
+                    Token = string.Empty;
+                    ErrorId = ChimeErrorId.DBAccessFail;
+                    _state = State.END;
+
+                    var currentTimestamp = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
+                    if (currentTimestamp - _lastRequestTimestamp >= TIMEOUT.TotalSeconds)
+                    {
+                        _client.CloseSession();
+                        ErrorId = ChimeErrorId.DBAccessTimeout;
+                        break;
+                    }
+
+                    if (_client.IsBusy)
+                    {
+                        _state = State.WAITING;
+                        break;
+                    }
+
+                    if (!_client.TryTakeResponse(out var responseRecord))
+                        break;
+
+                    using var _ = responseRecord;
+                    var task = responseRecord.Task;
+                    _client.CloseSession();
+                    if (task.IsCanceled)
+                        break;
+
+                    if (task.IsFaulted)
+                    {
+                        if (task.Exception.InnerException is not HttpRequestException ex)
+                        {
+                            break;
+                        }
+
+                        if (ex.HttpRequestError != HttpRequestError.NameResolutionError)
+                        {
+                            break;
+                        }
+
+                        ErrorId = ChimeErrorId.DBResolveFail;
+                        break;
+                    }
+
+                    var resp = task.Result;
+                    if (resp.StatusCode != HttpStatusCode.OK)
+                    {
+                        break;
+                    }
+
+                    try
+                    {
+                        var respData = resp
+                            .Content.ReadFromJsonAsync(CCommJsonContext.Default.GetUserDataResponse)
+                            .GetAwaiter()
+                            .GetResult();
+                        if (respData is null)
+                        {
+                            break;
+                        }
+
+                        if (respData.ErrorId != 0)
+                        {
+                            ErrorId = respData.ErrorId switch
+                            {
+                                0 => ChimeErrorId.None,
+                                1 => ChimeErrorId.ReaderIncompatible,
+                                2 => ChimeErrorId.AimeIdInvalid,
+                                3 => ChimeErrorId.LockBanSystemUser,
+                                4 => ChimeErrorId.LockBanSystem,
+                                5 => ChimeErrorId.LockBanUser,
+                                6 => ChimeErrorId.LockBan,
+                                7 => ChimeErrorId.LockSystemUser,
+                                8 => ChimeErrorId.LockSystem,
+                                9 => ChimeErrorId.LockUser,
+                                10 => ChimeErrorId.NoBoardInfo,
+                                _ => ChimeErrorId.DBAccessFail,
+                            };
+                            break;
+                        }
+
+                        ErrorId = ChimeErrorId.None;
+                        if (!TokenRegex().IsMatch(respData.Token))
+                        {
+                            break;
+                        }
+
+                        var validateSource = new UTF8Encoding().GetBytes(
+                            $"{respData.UserId}{respData.Timestamp}{CommonKey}"
+                        );
+                        var validateKey = Convert.ToHexString(SHA256.HashData(validateSource));
+                        if (validateKey != respData.Key)
+                        {
+                            break;
+                        }
+
+                        UserId = (uint)respData.UserId;
+                        Token = respData.Token;
+                        break;
+                    }
+                    catch
+                    {
+                        break;
+                    }
+                }
+                case State.END:
+                    break;
+                default:
+                    throw new ArgumentOutOfRangeException();
+            }
+        }
+
+        public void Dispose()
+        {
+            _client.CloseSession();
+            _client.Dispose();
+            Disposed = true;
+        }
+
+        private enum State
+        {
+            START,
+            WAITING,
+            END,
+        }
+
+        [GeneratedRegex(@"^[a-zA-Z\d]{20}$")]
+        private static partial Regex TokenRegex();
+    }
+}
