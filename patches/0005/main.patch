+using System;
+using System.Linq;
+using ChimeLib.NET.COMM;
+
+namespace ChimeLib.NET;
+
+public class ChimeUnit
+{
+    private ChimeResult? _result;
+    private ChimeErrorInfo _errorInfo = new();
+    private bool _hasError;
+    private readonly string _gameId;
+    private readonly string _chipId;
+    private readonly string _commonKey;
+    private readonly string _titleKey;
+    private readonly IUsbCameraDevice _cameraDevice;
+    private MainLoopPhase _phase = MainLoopPhase.INIT;
+    private CCommQrCode? _qrCode;
+    private CCommGetUserData? _pCommGetUserData;
+    private bool _qrOnlyFlag;
+
+    internal ChimeUnit(
+        string gameId,
+        string chipId,
+        string commonKey,
+        IUsbCameraDevice cameraDevice,
+        string titleKey
+    )
+    {
+        _gameId = gameId;
+        _chipId = chipId;
+        _commonKey = commonKey;
+        _cameraDevice = cameraDevice;
+        _qrOnlyFlag = false;
+        _titleKey = titleKey;
+    }
+
+    public bool Start(ChimeCommand command)
+    {
+        if (_hasError)
+        {
+            return false;
+        }
+
+        _result = new(ChimeId.Zero(), string.Empty);
+        _errorInfo = new(ChimeErrorId.None);
+        _qrOnlyFlag = false;
+        switch (command)
+        {
+            case ChimeCommand.Scan:
+                _phase = MainLoopPhase.SCAN_QR_CODE_INIT;
+                _qrOnlyFlag = false;
+                break;
+            case ChimeCommand.ScanQR:
+                _phase = MainLoopPhase.SCAN_QR_CODE_INIT;
+                _qrOnlyFlag = true;
+                break;
+            default:
+                throw new ArgumentOutOfRangeException(nameof(command), command, null);
+        }
+
+        if (!_cameraDevice.HasError())
+            return true;
+
+        // Original implementation: SetLedStatus(ChimeLedStatus.Error);
+        _errorInfo = new(ChimeErrorId.ReaderAccessFail);
+        _phase = MainLoopPhase.END;
+        _hasError = true;
+        return true;
+    }
+
+    public bool Cancel()
+    {
+        _phase = MainLoopPhase.INIT;
+        _cameraDevice.CancelScan();
+        _pCommGetUserData?.Dispose();
+        _pCommGetUserData = null;
+        _qrCode = null;
+        return true;
+    }
+
+    public bool IsReady() => _cameraDevice.IsReady();
+
+    internal void Execute()
+    {
+        switch (_phase)
+        {
+            case MainLoopPhase.INIT:
+            case MainLoopPhase.IDLE:
+                break;
+            case MainLoopPhase.SCAN_QR_CODE_INIT:
+                _cameraDevice.BeginScan();
+                _phase = MainLoopPhase.SCAN_QR_CODE_IDLE;
+                break;
+            case MainLoopPhase.SCAN_QR_CODE_IDLE:
+            {
+                if (_cameraDevice.HasError())
+                {
+                    // Original implementation: SetLedStatus(ChimeLedStatus.Error);
+                    _errorInfo = new(ChimeErrorId.ReaderAccessFail);
+                    _cameraDevice.CancelScan();
+                    _hasError = true;
+                    _phase = MainLoopPhase.END;
+                    break;
+                }
+
+                var decodeStrings = _cameraDevice.GetDecodeStrings();
+                if (
+                    decodeStrings.Any(qRCode =>
+                        CCommQrCode.TryCreateValid(_gameId, qRCode, out _qrCode)
+                    )
+                )
+                {
+                    _cameraDevice.EndScan();
+                    _phase = MainLoopPhase.SCAN_QR_CODE_BUSY;
+                }
+
+                break;
+            }
+            case MainLoopPhase.SCAN_QR_CODE_BUSY:
+                _phase = _qrOnlyFlag ? MainLoopPhase.END : MainLoopPhase.DB_ALIVE_INIT;
+                break;
+            case MainLoopPhase.DB_ALIVE_INIT:
+                Chime.Instance!.StartDBAliveCheckStart();
+                _phase = MainLoopPhase.DB_ALIVE_IDLE;
+                break;
+            case MainLoopPhase.DB_ALIVE_IDLE:
+                if (!Chime.Instance!.IsDBAliveCheckBusy())
+                {
+                    _phase = MainLoopPhase.GET_USER_DATA_INIT;
+                }
+                break;
+            case MainLoopPhase.GET_USER_DATA_INIT:
+                _pCommGetUserData = new(
+                    _gameId,
+                    _chipId,
+                    _commonKey,
+                    _qrCode!.DataSection,
+                    _titleKey,
+                    Chime.Instance!.GetIndex()
+                );
+                _phase = MainLoopPhase.GET_USER_DATA_IDLE;
+                break;
+            case MainLoopPhase.GET_USER_DATA_IDLE:
+                if (_pCommGetUserData?.IsEnd ?? true)
+                {
+                    _result?.ChimeId.SetZero();
+                    if (_pCommGetUserData != null)
+                    {
+                        var errorId = _pCommGetUserData.GetErrorId();
+                        _errorInfo = new(errorId);
+                        if (errorId == ChimeErrorId.None)
+                        {
+                            _result = new(
+                                ChimeId.Make(_pCommGetUserData.UserId),
+                                _pCommGetUserData.Token
+                            );
+                            Chime.Instance!.SetDBAliveCheckResult(flag: true);
+                        }
+
+                        _pCommGetUserData.Dispose();
+                        _pCommGetUserData = null;
+                    }
+
+                    _phase = MainLoopPhase.END;
+                }
+                else
+                {
+                    _pCommGetUserData.Execute();
+                }
+                break;
+            case MainLoopPhase.END:
+                break;
+            default:
+                throw new ArgumentOutOfRangeException();
+        }
+
+        if (
+            _phase is MainLoopPhase.SCAN_QR_CODE_INIT or MainLoopPhase.SCAN_QR_CODE_IDLE
+            && _cameraDevice.IsReady()
+            && GetLedStatus() != ChimeLedStatus.Scanning
+        )
+        {
+            // Original implementation: SetLedStatus(ChimeLedStatus.Scanning);
+        }
+
+        if (!_cameraDevice.HasError())
+            return;
+
+        // Original implementation: SetLedStatus(ChimeLedStatus.Error);
+        _errorInfo = new(ChimeErrorId.ReaderAccessFail);
+        _cameraDevice.CancelScan();
+        _phase = MainLoopPhase.END;
+        _hasError = true;
+    }
+
+    public bool IsBusy()
+    {
+        return _phase != MainLoopPhase.INIT
+            && _phase != MainLoopPhase.IDLE
+            && _phase != MainLoopPhase.END;
+    }
+
+    public bool HasConfirm()
+    {
+        return GetConfirm() != ChimeConfirm.None;
+    }
+
+    public ChimeConfirm GetConfirm() => ChimeConfirm.None;
+
+    public bool AcceptConfirm() => false;
+
+    public bool HasResult()
+    {
+        return GetResult().Valid();
+    }
+
+    public ChimeResult GetResult() => _result ?? new(ChimeId.Zero(), string.Empty);
+
+    public bool HasError() => GetErrorInfo().IsOccurred();
+
+    public ChimeErrorInfo GetErrorInfo() => _errorInfo;
+
+    public ChimeLedStatus GetLedStatus() => ChimeLedStatus.None;
+
+    public bool SetLedStatus(ChimeLedStatus status) => false;
+
+    public bool SetLed(bool onR, bool onG, bool onB) => false;
+
+    private enum MainLoopPhase
+    {
+        INIT,
+        IDLE,
+        SCAN_QR_CODE_INIT,
+        SCAN_QR_CODE_IDLE,
+        SCAN_QR_CODE_BUSY,
+        DB_ALIVE_INIT,
+        DB_ALIVE_IDLE,
+        GET_USER_DATA_INIT,
+        GET_USER_DATA_IDLE,
+        END,
+    }
+}
