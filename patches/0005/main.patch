+using System;
+using System.Diagnostics.CodeAnalysis;
+
+namespace ChimeLib.NET.COMM;
+
+internal record CCommQrCode
+{
+    private const int ID_INDEX_WECHAT = 0;
+    private const int ID_INDEX_GAME_ID = 4;
+
+    private readonly string _gameId;
+    private readonly string _qrCode;
+
+    public string DataSection => _qrCode[20..];
+
+    private CCommQrCode(string gameId, string qrCode)
+    {
+        _gameId = gameId;
+        _qrCode = qrCode;
+    }
+
+    internal static bool TryCreateValid(
+        string gameId,
+        string qrCode,
+        [NotNullWhen(true)] out CCommQrCode? instance
+    )
+    {
+        if (
+            qrCode.IndexOf(Chime.WECHAT_ID, StringComparison.Ordinal) == ID_INDEX_WECHAT
+            && qrCode.IndexOf(gameId, StringComparison.Ordinal) == ID_INDEX_GAME_ID
+        )
+        {
+            instance = new(gameId, qrCode);
+            return true;
+        }
+
+        instance = null;
+        return false;
+    }
+}
