+using System;
+using System.Net;
+using System.Net.Http;
+
+namespace ChimeLib.NET.COMM;
+
+internal class CCommServAliveCheck : IDisposable
+{
+    private CCommServAliveCheckImpl? _instance;
+
+    internal bool IsAlive => _instance?.IsAlive == true;
+
+    internal bool IsBusy => _instance?.IsBusy == true;
+
+    internal ulong Index => _instance?.GetNextServerIndex() == 1 ? 1UL : 0UL;
+
+    internal CCommServAliveCheck() => Create();
+
+    public void Dispose() => Destroy();
+
+    private void Create()
+    {
+        if (_instance?.Disposed == false)
+        {
+            Destroy();
+        }
+
+        _instance = new();
+    }
+
+    internal void Destroy()
+    {
+        _instance?.Dispose();
+        _instance = null;
+    }
+
+    internal void BeginPlay() => _instance?.IsPlaying = true;
+
+    internal void EndPlay() => _instance?.IsPlaying = false;
+
+    internal void StartCheck() => _instance?.StartCheck();
+
+    internal void CancelCheck() => _instance?.CancelCheck();
+
+    internal void SetCheckResult(bool flag) => _instance?.SetCheckResult(flag);
+
+    internal void SetConnectPermission(bool flag) => _instance?.SetConnectPermission(flag);
+
+    internal void Execute() => _instance?.Execute();
+
+    private sealed class CCommServAliveCheckImpl : IDisposable
+    {
+        private const int CHECK_INTERVAL_SECONDS_SHORT = 60;
+        private const int CHECK_INTERVAL_SECONDS_LONG = 900;
+        private const int DEFAULT_TIMEOUT_SECONDS = 15;
+        private static readonly string[] BASE_URL_LIST =
+        [
+            "https://ai.sys-allnet.cn/",
+            "https://ai.sys-all.cn/",
+        ];
+        private static readonly string[] API_PATH_LIST =
+        [
+            "qrcode/api/alive_check",
+            "wc_aime/api/alive_check",
+        ];
+
+        private readonly CCommHttpClient _client = new();
+        private ChimeErrorId _errorId = ChimeErrorId.None;
+        private State _state = State.IDLE;
+        private bool _useCustomHost = false;
+        private string _customHost = string.Empty;
+        private int _pathIndex;
+        private bool _hasConnectPerm;
+        private long _lastRequestTimestamp;
+        private long _lastSetResultTimestamp;
+        private ulong _lastServerIndex = ulong.MaxValue;
+        private ulong _currentServerIndex = ulong.MaxValue;
+        private int _requestTimeoutSeconds = DEFAULT_TIMEOUT_SECONDS;
+
+        public bool IsAlive { get; private set; }
+
+        public bool IsBusy => _state != State.IDLE;
+
+        public bool IsPlaying { get; set; }
+
+        public bool Disposed { get; private set; }
+
+        public void Dispose()
+        {
+            if (Disposed)
+            {
+                return;
+            }
+
+            _client.CloseSession();
+            _client.Dispose();
+            Disposed = true;
+        }
+
+        internal void StartCheck()
+        {
+            _client.CancelRequest();
+            _state = State.START;
+            if (_useCustomHost)
+            {
+                _pathIndex = 1;
+            }
+        }
+
+        internal void SetCheckResult(bool flag)
+        {
+            IsAlive = flag;
+            _lastSetResultTimestamp = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
+        }
+
+        internal void CancelCheck()
+        {
+            _client.CloseSession();
+            _state = State.IDLE;
+        }
+
+        internal void SetConnectPermission(bool perm)
+        {
+            _hasConnectPerm = perm;
+            IsAlive = false;
+            _client.CancelRequest();
+            _lastRequestTimestamp = 0;
+            _lastSetResultTimestamp = 0;
+            _state = State.IDLE;
+            _lastServerIndex = ulong.MaxValue;
+            _currentServerIndex = ulong.MaxValue;
+        }
+
+        internal void Execute()
+        {
+            switch (_state)
+            {
+                case State.IDLE:
+                {
+                    if (!_hasConnectPerm || IsPlaying)
+                    {
+                        break;
+                    }
+
+                    var currentTimestamp = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
+                    var secondsSinceLastCheck = currentTimestamp - _lastSetResultTimestamp;
+                    var checkInterval = IsAlive
+                        ? CHECK_INTERVAL_SECONDS_LONG
+                        : CHECK_INTERVAL_SECONDS_SHORT;
+                    if (secondsSinceLastCheck >= checkInterval)
+                    {
+                        _pathIndex = 0;
+                        _state = State.START;
+                    }
+                    break;
+                }
+                case State.START:
+                {
+                    if (!_hasConnectPerm)
+                    {
+                        _state = State.IDLE;
+                        break;
+                    }
+
+                    string baseUrl;
+                    if (_customHost.Length != 0)
+                    {
+                        baseUrl = _customHost;
+                    }
+                    else
+                    {
+                        var nextServerIndex = GetNextServerIndex();
+                        _currentServerIndex = nextServerIndex;
+                        baseUrl = BASE_URL_LIST[_currentServerIndex];
+                    }
+                    var url = baseUrl + API_PATH_LIST[_pathIndex];
+                    _client.OpenSession();
+                    _client.SendRequest(url, []);
+                    IsAlive = false;
+                    _errorId = ChimeErrorId.None;
+                    _lastRequestTimestamp = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
+                    _state = State.WAITING;
+                    break;
+                }
+                case State.WAITING:
+                {
+                    var currentTimestamp = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
+                    var timeElapsed = currentTimestamp - _lastRequestTimestamp;
+                    if (_client.IsBusy && timeElapsed < _requestTimeoutSeconds)
+                    {
+                        break;
+                    }
+
+                    var nextServerIndex = GetNextServerIndex();
+                    var hasNextServer = nextServerIndex != ulong.MaxValue;
+                    HttpRequestException? requestException = null;
+                    var statusCode = (HttpStatusCode?)null;
+                    var content = string.Empty;
+
+                    if (!_client.IsBusy)
+                    {
+                        if (_client.TryTakeResponse(out var responseRecord))
+                        {
+                            using var _ = responseRecord;
+                            var responseTask = responseRecord.Task;
+                            if (responseTask.IsCompletedSuccessfully)
+                            {
+                                var response = responseTask.Result;
+                                statusCode = response.StatusCode;
+                                if (statusCode == HttpStatusCode.OK)
+                                {
+                                    content = response
+                                        .Content.ReadAsStringAsync()
+                                        .GetAwaiter()
+                                        .GetResult();
+                                }
+                            }
+                            else
+                            {
+                                requestException =
+                                    responseTask.Exception?.InnerException as HttpRequestException;
+                            }
+
+                            if (statusCode == HttpStatusCode.OK)
+                            {
+                                if (content == "alive")
+                                {
+                                    IsAlive = true;
+                                    _lastServerIndex = _currentServerIndex;
+                                    hasNextServer = false;
+                                }
+
+                                _errorId = ChimeErrorId.None;
+                            }
+                        }
+                    }
+
+                    if (statusCode != HttpStatusCode.OK && !hasNextServer)
+                    {
+                        _errorId =
+                            requestException?.HttpRequestError
+                            == HttpRequestError.NameResolutionError
+                                ? ChimeErrorId.DBResolveFail
+                                : ChimeErrorId.DBAccessFail;
+                    }
+
+                    _lastSetResultTimestamp = currentTimestamp;
+                    _client.CloseSession();
+                    if (!hasNextServer)
+                    {
+                        _currentServerIndex = ulong.MaxValue;
+                        _pathIndex++;
+                        if (_pathIndex >= API_PATH_LIST.Length || _errorId != ChimeErrorId.None)
+                        {
+                            _pathIndex = 0;
+                            _state = State.IDLE;
+                            break;
+                        }
+                    }
+
+                    _state = State.START;
+                    break;
+                }
+                default:
+                    throw new ArgumentOutOfRangeException();
+            }
+        }
+
+        internal ulong GetNextServerIndex()
+        {
+            if (_customHost.Length != 0)
+            {
+                return ulong.MaxValue;
+            }
+
+            if (_currentServerIndex == ulong.MaxValue)
+            {
+                return _lastServerIndex == ulong.MaxValue ? 0 : _lastServerIndex;
+            }
+
+            var result = _currentServerIndex + 1;
+            if (result == 2)
+            {
+                result = _lastServerIndex == ulong.MaxValue ? ulong.MaxValue : 0;
+            }
+
+            if (_lastServerIndex != ulong.MaxValue && result == _lastServerIndex)
+            {
+                return ulong.MaxValue;
+            }
+
+            return result;
+        }
+
+        private enum State
+        {
+            IDLE,
+            START,
+            WAITING,
+        }
+    }
+}
