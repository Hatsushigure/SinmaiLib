+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Threading;
+using ChimeLib.NET.COMM;
+
+namespace ChimeLib.NET;
+
+public class Chime : IDisposable
+{
+    internal const string WECHAT_ID = "SGWC";
+    internal const string LIB_VERSION = "1.0.0";
+    internal const string HARD_VERSION = "1.0.0";
+    internal const string FIRM_VERSION = "1.0.0";
+
+    private readonly CultureInfo _originalCulture;
+    private ChimeUnit? _unit;
+    private CCommServAliveCheck? _servAliveCheck;
+
+    public static Chime? Instance { get; private set; }
+
+    public List<ChimeErrorMessage> ErrorMessageList { get; set; } = [];
+
+    public static void Create() => Instance ??= new Chime();
+
+    public static void Destroy()
+    {
+        Instance?.Dispose();
+        Instance = null;
+    }
+
+    private Chime()
+    {
+        _originalCulture = Thread.CurrentThread.CurrentCulture;
+        Thread.CurrentThread.CurrentCulture = new CultureInfo("zh-CN");
+    }
+
+    public void Dispose()
+    {
+        Thread.CurrentThread.CurrentCulture = _originalCulture;
+        _servAliveCheck?.Dispose();
+    }
+
+    public void Init(string openGameId, string keyChipId, IUsbCameraDevice device, string titleKey)
+    {
+        _unit = new(openGameId, keyChipId, string.Empty, device, titleKey);
+        _servAliveCheck?.Dispose();
+        _servAliveCheck = new CCommServAliveCheck();
+    }
+
+    public int GetUnitCount() => _unit is null ? 0 : 1;
+
+    public ChimeUnit? GetUnit(int unitIndex = 0)
+    {
+        if (unitIndex != 0)
+        {
+            return null;
+        }
+
+        return _unit;
+    }
+
+    public void Execute()
+    {
+        _unit?.Execute();
+        _servAliveCheck?.Execute();
+    }
+
+    public bool IsReady(int unitIndex = 0)
+    {
+        if (unitIndex != 0)
+        {
+            return false;
+        }
+
+        return _unit?.IsReady() ?? false;
+    }
+
+    public void StartDBAliveCheckStart() => _servAliveCheck?.StartCheck();
+
+    public bool IsDBAliveCheckBusy() => _servAliveCheck?.IsBusy ?? false;
+
+    public void SetDBAliveConnectPermission(bool flag) =>
+        _servAliveCheck?.SetConnectPermission(flag);
+
+    internal void SetDBAliveCheckResult(bool flag) => _servAliveCheck?.SetCheckResult(flag);
+
+    public bool IsDBAlive() => _servAliveCheck?.IsAlive ?? false;
+
+    public void BeginPlay() => _servAliveCheck?.BeginPlay();
+
+    public void EndPlay() => _servAliveCheck?.EndPlay();
+
+    public static string GetVersion() => LIB_VERSION;
+
+    public ulong GetIndex() => _servAliveCheck?.Index ?? 0;
+}
