+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.IO.Compression;
+using System.Linq;
+using System.Net;
+using System.Net.Http;
+using System.Net.Http.Headers;
+using System.Net.Security;
+using System.Security.Cryptography.X509Certificates;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+using AMDaemon.Allnet;
+using MAI2.Util;
+using Manager;
+
+namespace Net;
+
+internal class NetHttpClient : IDisposable
+{
+    private const int DefaultTimeoutMsec = 60000;
+    private const string MaiEncodingKey = "Mai-Encoding";
+    private const string MaiEncodingVal = "1.55";
+    private const string ContentTypeJson = "application/json";
+    private const string ContentEncodingDeflate = "deflate";
+    private const int StateReady = 1;
+    private const int StateProcess = 3;
+    private const int StateDone = 4;
+    private const int StateError = 5;
+
+    private readonly Uri _uri;
+    private readonly HttpClientHandler _handler;
+    private readonly HttpClient _client;
+    private readonly Dictionary<string, List<string>> _headers = new(
+        StringComparer.OrdinalIgnoreCase
+    );
+    private readonly Lock _lock = new();
+    private CancellationTokenSource? _requestCancellation;
+    private bool _disposed;
+    private static byte[][]? _hostBytes;
+
+    public int TimeOutInMSec { get; set; } = DefaultTimeoutMsec;
+
+    public WebExceptionStatus WebException { get; private set; }
+
+    public string Error { get; private set; } = string.Empty;
+
+    public int State
+    {
+        get
+        {
+            lock (_lock)
+            {
+                return field;
+            }
+        }
+        private set
+        {
+            lock (_lock)
+            {
+                field = value;
+            }
+        }
+    }
+
+    public int HttpStatus { get; private set; } = -1;
+
+    public byte[] ResponseData { get; private set; } = [];
+
+    public CookieCollection Cookie { get; private set; } = new();
+
+    private NetHttpClient(Uri uri)
+    {
+        _uri = uri;
+        _handler = new HttpClientHandler
+        {
+            UseCookies = true,
+            CookieContainer = new CookieContainer(),
+            ServerCertificateCustomValidationCallback = CheckServerHash,
+        };
+        _client = new HttpClient(_handler) { Timeout = Timeout.InfiniteTimeSpan };
+        _client.DefaultRequestHeaders.Add(MaiEncodingKey, MaiEncodingVal);
+        State = StateReady;
+    }
+
+    public static NetHttpClient? Create(string url)
+    {
+        try
+        {
+            _hostBytes ??= [.. Auth.GameServerHost.Split(':').Select(Encoding.ASCII.GetBytes)];
+            return new NetHttpClient(new Uri(url, UriKind.Absolute));
+        }
+        catch
+        {
+            return null;
+        }
+    }
+
+    public void Dispose()
+    {
+        Dispose(true);
+        GC.SuppressFinalize(this);
+    }
+
+    protected virtual void Dispose(bool disposing)
+    {
+        if (!disposing)
+            return;
+
+        lock (_lock)
+        {
+            if (_disposed)
+                return;
+            _disposed = true;
+            _requestCancellation?.Cancel();
+        }
+        _client.Dispose();
+        _handler.Dispose();
+        _requestCancellation?.Dispose();
+    }
+
+    public void AddHeader(string name, string value)
+    {
+        EnsureInitialized();
+        if (string.IsNullOrWhiteSpace(name))
+            throw new ArgumentException("Header name is required.", nameof(name));
+        if (_headers.TryGetValue(name, out var vals))
+        {
+            vals.Add(value);
+        }
+        else
+        {
+            _headers[name] = [value];
+        }
+    }
+
+    public void AddCookie(ulong userId)
+    {
+        EnsureInitialized();
+        var cookies = Singleton<OperationManager>.Instance.GetCookie(userId);
+        if (cookies != null)
+        {
+            _handler.CookieContainer = cookies;
+        }
+    }
+
+    public bool Request(byte[] data, string userAgent, string method = "POST")
+    {
+        EnsureInitialized();
+        ResetStatus();
+        try
+        {
+            State = StateProcess;
+            _ = RunRequestAsync(data, userAgent, method, CancellationToken.None)
+                .ContinueWith(t =>
+                {
+                    if (t is { IsFaulted: true, Exception: not null })
+                        SetError(t.Exception.GetBaseException());
+                });
+            return true;
+        }
+        catch (Exception ex)
+        {
+            SetError(ex);
+            return false;
+        }
+    }
+
+    public async Task<bool> RequestAsync(
+        byte[] bytes,
+        string userAgent,
+        string method = "POST",
+        CancellationToken cancellationToken = default
+    )
+    {
+        EnsureInitialized();
+        ResetStatus();
+        State = StateProcess;
+        try
+        {
+            await RunRequestAsync(bytes, userAgent, method, cancellationToken);
+            return State == StateDone;
+        }
+        catch (Exception ex)
+        {
+            SetError(ex);
+            return false;
+        }
+    }
+
+    public Task<bool> RequestAsync(CancellationToken cancellationToken = default) =>
+        RequestAsync([], string.Empty, "POST", cancellationToken);
+
+    private async Task RunRequestAsync(
+        byte[] data,
+        string userAgent,
+        string method,
+        CancellationToken cancellationToken
+    )
+    {
+        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
+        if (TimeOutInMSec >= 0)
+            timeout.CancelAfter(TimeOutInMSec);
+        lock (_lock)
+        {
+            _requestCancellation = timeout;
+        }
+        using var content = new ByteArrayContent(
+            data.Length == 0 ? [] : EncodeRequestPayload(data)
+        );
+        using var request = new HttpRequestMessage(new HttpMethod(method), _uri)
+        {
+            Version = HttpVersion.Version11,
+            Content = content,
+        };
+        request.Headers.TryAddWithoutValidation("User-Agent", userAgent);
+        content.Headers.ContentType = new MediaTypeHeaderValue(ContentTypeJson);
+        content.Headers.TryAddWithoutValidation("charset", "UTF-8");
+        if (data.Length != 0)
+        {
+            content.Headers.ContentEncoding.Add(ContentEncodingDeflate);
+        }
+        foreach (var header in _headers)
+        {
+            request.Headers.TryAddWithoutValidation(header.Key, header.Value);
+        }
+        try
+        {
+            using var response = await _client.SendAsync(
+                request,
+                HttpCompletionOption.ResponseContentRead,
+                timeout.Token
+            );
+            HttpStatus = (int)response.StatusCode;
+            Cookie = _handler.CookieContainer.GetCookies(_uri);
+            var payload = await response.Content.ReadAsByteArrayAsync(timeout.Token);
+            ResponseData =
+                response.IsSuccessStatusCode && payload.Length != 0
+                    ? DecodeResponsePayload(payload)
+                    : [];
+            if (!response.IsSuccessStatusCode)
+            {
+                WebException = WebExceptionStatus.ProtocolError;
+                Error = $"HTTP {(int)response.StatusCode} ({response.ReasonPhrase})";
+                State = StateError;
+                return;
+            }
+            WebException = WebExceptionStatus.Success;
+            Error = string.Empty;
+            State = StateDone;
+        }
+        finally
+        {
+            lock (_lock)
+            {
+                _requestCancellation = null;
+            }
+        }
+    }
+
+    private void EnsureInitialized()
+    {
+        if (_disposed)
+            throw new NullReferenceException("Trying to use an uninitialized NetHttpClient");
+    }
+
+    private void ResetStatus()
+    {
+        WebException = WebExceptionStatus.Success;
+        HttpStatus = -1;
+        Error = string.Empty;
+        ResponseData = [];
+    }
+
+    private void SetError(Exception exception)
+    {
+        WebException = MapWebExceptionStatus(exception);
+        Error = exception.Message;
+        State = StateError;
+    }
+
+    private static WebExceptionStatus MapWebExceptionStatus(Exception exception)
+    {
+        return exception switch
+        {
+            WebException webException => webException.Status,
+            OperationCanceledException => WebExceptionStatus.Timeout,
+            HttpRequestException requestException => requestException.HttpRequestError switch
+            {
+                HttpRequestError.Unknown => WebExceptionStatus.UnknownError,
+                HttpRequestError.NameResolutionError => WebExceptionStatus.NameResolutionFailure,
+                HttpRequestError.ConnectionError => WebExceptionStatus.ConnectFailure,
+                HttpRequestError.SecureConnectionError => WebExceptionStatus.SecureChannelFailure,
+                HttpRequestError.HttpProtocolError => WebExceptionStatus.ProtocolError,
+                HttpRequestError.ExtendedConnectNotSupported => WebExceptionStatus.ConnectFailure,
+                HttpRequestError.VersionNegotiationError => WebExceptionStatus.ConnectFailure,
+                HttpRequestError.UserAuthenticationError => WebExceptionStatus.ProtocolError,
+                HttpRequestError.ProxyTunnelError => WebExceptionStatus.ConnectFailure,
+                HttpRequestError.InvalidResponse => WebExceptionStatus.ServerProtocolViolation,
+                HttpRequestError.ResponseEnded => WebExceptionStatus.ConnectionClosed,
+                HttpRequestError.ConfigurationLimitExceeded =>
+                    WebExceptionStatus.MessageLengthLimitExceeded,
+                _ => WebExceptionStatus.UnknownError,
+            },
+            _ => WebExceptionStatus.UnknownError,
+        };
+    }
+
+    private static byte[] Compress(byte[] data)
+    {
+        using var output = new MemoryStream();
+        using var zlibStream = new ZLibStream(output, CompressionMode.Compress);
+        zlibStream.Write(data);
+        zlibStream.Close();
+        return output.ToArray();
+    }
+
+    private static byte[] Decompress(byte[] data)
+    {
+        using var input = new MemoryStream(data, writable: false);
+        using var zlibStream = new ZLibStream(input, CompressionMode.Decompress);
+        using var output = new MemoryStream();
+        zlibStream.CopyTo(output);
+        return output.ToArray();
+    }
+
+    private static byte[] EncodeRequestPayload(byte[] data) => CipherAes.Encrypt(Compress(data));
+
+    private static byte[] DecodeResponsePayload(byte[] data) => Decompress(CipherAes.Decrypt(data));
+
+    private static bool CheckServerParameter(byte[] inData, byte[] compare)
+    {
+        inData[43] = (byte)'=';
