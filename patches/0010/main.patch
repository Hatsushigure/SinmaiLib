-    private static void ReadCallback(IAsyncResult asynchronousResult)
-    {
-        var netHttpClient = (NetHttpClient)asynchronousResult.AsyncState!;
-        try
-        {
-            var responseStream = netHttpClient._responseStream!;
-            var readCount = responseStream.EndRead(asynchronousResult);
-            if (readCount > 0)
-            {
-                netHttpClient._tempResponseStream.Write(
-                    netHttpClient._responseBuffer,
-                    0,
-                    readCount
-                );
-                responseStream.BeginRead(
-                    netHttpClient._responseBuffer,
-                    0,
-                    1024,
-                    ReadCallback,
-                    netHttpClient
-                );
-            }
-            else if (asynchronousResult.IsCompleted)
-            {
-                var payload = netHttpClient._tempResponseStream.ToArray();
-                netHttpClient._tempResponseStream.Seek(0, SeekOrigin.Begin);
-                netHttpClient._tempResponseStream.SetLength(0);
-                var decodedPayload = DecodeResponsePayload(payload);
-                netHttpClient.ResponseData = decodedPayload;
-                netHttpClient.SetSuccess(StateDone);
-            }
-        }
-        catch (Exception ex)
-        {
-            netHttpClient.SetError(ex);
-        }
-    }
