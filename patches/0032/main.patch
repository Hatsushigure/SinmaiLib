+using System;
+using System.IO;
+using AMDaemon.Allnet;
+using Manager;
+using Net.VO;
+using Net.VO.Mai2;
+
+namespace Net.Packet.Mai2;
+
+internal class PacketUpsertClientUpload : Packet
+{
+    private const int ChunkSize = 10240;
+    private const string ApiName = "UpsertClientUploadApi";
+
+    private readonly Action<int> _onDone;
+    private readonly Action<PacketStatus>? _onError;
+    private readonly byte[] _source;
+    private readonly int _chunkCount;
+    private readonly string _filePath;
+    private readonly string _uploadTime = TimeManager.GetNowDateString();
+    private int _currentChunkIndex;
+
+    public PacketUpsertClientUpload(
+        string errorLog,
+        byte[] source,
+        Action<int> onDone,
+        Action<PacketStatus>? onError = null
+    )
+    {
+        _onDone = onDone;
+        _onError = onError;
+        _source = source;
+        _filePath = errorLog;
+        _chunkCount = _source.Length / ChunkSize + (_source.Length % ChunkSize != 0 ? 1 : 0);
+        Create(GetNetQuery());
+        _currentChunkIndex++;
+    }
+
+    public override PacketState Proc()
+    {
+        switch (ProcImpl())
+        {
+            case PacketState.Done:
+            {
+                var netQuery = (NetQuery<ClientUploadRequestVO, UpsertResponseVO>)Query;
+                if (_currentChunkIndex < _chunkCount)
+                {
+                    Create(GetNetQuery(netQuery.Response!.ReturnCode));
+                    _currentChunkIndex++;
+                }
+                else
+                {
+                    try
+                    {
+                        File.Delete(_filePath);
+                    }
+                    catch
+                    {
+                        // ignored
+                    }
+
+                    _onDone(netQuery.Response!.ReturnCode);
+                }
+                break;
+            }
+            case PacketState.Error:
+                _onError?.Invoke(Status);
+                break;
+            case PacketState.Ready:
+            case PacketState.Process:
+            case PacketState.RetryWait:
+            case PacketState.Dialog:
+                break;
+            default:
+                throw new ArgumentOutOfRangeException();
+        }
+        return State;
+    }
+
+    private NetQuery<ClientUploadRequestVO, UpsertResponseVO> GetNetQuery(int orderId = 0) =>
+        new(ApiName)
+        {
+            Request = new ClientUploadRequestVO
+            {
+                ClientUpload = new ClientUpload
+                {
+                    OrderId = orderId,
+                    DivNumber = _currentChunkIndex,
+                    DivLength = _chunkCount,
+                    DivData = GetChunkDataBase64(_currentChunkIndex),
+                    PlaceId = (int)Auth.LocationId,
+                    ClientId = AMDaemon.System.KeychipId.ShortValue,
+                    UploadDate = _uploadTime,
+                    FileName = Path.GetFileName(_filePath),
+                },
+            },
+        };
+
+    private string GetChunkDataBase64(int chunkIndex) =>
+        Convert.ToBase64String(
+            _source.AsSpan(
+                chunkIndex * ChunkSize,
+                Math.Min(ChunkSize, _source.Length - chunkIndex * ChunkSize)
+            )
+        );
+}
