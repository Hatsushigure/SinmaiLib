+using System;
+using AMDaemon.Allnet;
+using MAI2.Util;
+using Manager;
+using Net.VO;
+using Net.VO.Mai2;
+
+namespace Net.Packet.Mai2;
+
+internal class PacketUserLogout : Packet
+{
+    private readonly Action _onDone;
+    private readonly Action<PacketStatus>? _onError;
+
+    public PacketUserLogout(
+        int index,
+        ulong userId,
+        LogoutType logoutType,
+        string acsessCode,
+        Action onDone,
+        Action<PacketStatus>? onError = null
+    )
+    {
+        _onDone = onDone;
+        _onError = onError;
+        var userDataById = Singleton<UserDataManager>.Instance.GetUserDataByID(userId);
+        if (
+            !Singleton<OperationManager>.Instance.IsCollectDelayInfoDisable()
+            && logoutType == LogoutType.Logout
+            && userDataById is not null
+        )
+        {
+            var netDelayLog = userDataById.NetDelayLog;
+            const int num = 23;
+            for (var i = 0; i <= num; i++)
+            {
+                netDelayLog.LoginMsec += netDelayLog.Request[i].Msec;
+                netDelayLog.DlSize += netDelayLog.Request[i].Size;
+            }
+            var requestApi = netDelayLog.Request[13];
+            if (requestApi.Count > 2)
+            {
+                netDelayLog.ReductionMusic =
+                    requestApi.Msec * (requestApi.Count - 1) / requestApi.Count;
+            }
+            RequestAPI requestApi2 = netDelayLog.Request[2];
+            if (requestApi2.Count > 12)
+            {
+                netDelayLog.ReductionItem =
+                    requestApi2.Msec * (requestApi2.Count - 12) / requestApi2.Count;
+            }
+            var netQuery = new NetQuery<UserLogoutRequest2VO, UserLogoutResponseVO>(
+                "UserLogoutApi",
+                userId
+            )
+            {
+                Request = new UserLogoutRequest2VO
+                {
+                    UserId = userId,
+                    AccessCode = acsessCode,
+                    ClientId = AMDaemon.System.KeychipId.ShortValue,
+                    RegionId = Auth.RegionCode,
+                    PlaceId = (int)Auth.LocationId,
+                    LoginDateTime = NetDataManager.Instance.GetLoginVO(index).LoginDateTime,
+                    Type = logoutType,
+                    DelayLog = netDelayLog,
+                },
+            };
+            Create(netQuery);
+        }
+        else
+        {
+            var netQuery2 = new NetQuery<UserLogoutRequestVO, UserLogoutResponseVO>(
+                "UserLogoutApi",
+                userId
+            )
+            {
+                Request = new UserLogoutRequestVO
+                {
+                    UserId = userId,
+                    AccessCode = acsessCode,
+                    ClientId = AMDaemon.System.KeychipId.ShortValue,
+                    RegionId = Auth.RegionCode,
+                    PlaceId = (int)Auth.LocationId,
+                    LoginDateTime = NetDataManager.Instance.GetLoginVO(index).LoginDateTime,
+                    Type = logoutType,
+                },
+            };
+            Create(netQuery2);
+        }
+    }
+
+    public override PacketState Proc()
+    {
+        switch (ProcImpl())
+        {
+            case PacketState.Done:
+                _onDone();
+                break;
+            case PacketState.Error:
+                _onError?.Invoke(Status);
+                break;
+            case PacketState.Ready:
+            case PacketState.Process:
+            case PacketState.RetryWait:
+            case PacketState.Dialog:
+                break;
+            default:
+                throw new ArgumentOutOfRangeException();
+        }
+        return State;
+    }
+}
