+using System;
+using DB;
+
+namespace Manager.UserDatas;
+
+[Serializable]
+public class UserScore
+{
+    public int Id;
+
+    public uint PlayCount;
+
+    public uint Achievement;
+
+    public PlayComboflagID ComboStatus;
+
+    public PlaySyncflagID SyncStatus;
+
+    public uint Deluxscore;
+
+    public MusicClearrankID ScoreRank;
+
+    public uint ExtNum1;
+
+    public UserScore(int _id)
+    {
+        Id = _id;
+        PlayCount = 0u;
+        Achievement = 0u;
+        ComboStatus = PlayComboflagID.None;
+        SyncStatus = PlaySyncflagID.None;
+        Deluxscore = 0u;
+        ScoreRank = MusicClearrankID.Rank_D;
+        ExtNum1 = 0u;
+    }
+
+    public bool IsFullCombo()
+    {
+        if (ComboStatus != PlayComboflagID.Gold)
+        {
+            return ComboStatus == PlayComboflagID.Silver;
+        }
+        return true;
+    }
+
+    public bool IsAllPerfect()
+    {
+        if (ComboStatus != PlayComboflagID.AllPerfect)
+        {
+            return ComboStatus == PlayComboflagID.AllPerfectPlus;
+        }
+        return true;
+    }
+
+    public bool IsChain()
+    {
+        if (SyncStatus != PlaySyncflagID.ChainLow)
+        {
+            return SyncStatus == PlaySyncflagID.ChainHi;
+        }
+        return true;
+    }
+
+    public bool IsSync()
+    {
+        if (SyncStatus != PlaySyncflagID.SyncLow)
+        {
+            return SyncStatus == PlaySyncflagID.SyncHi;
+        }
+        return true;
+    }
+}
