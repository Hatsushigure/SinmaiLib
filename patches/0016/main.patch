+using System;
+using System.Collections.Generic;
+using MAI2.Util;
+using Manager;
+using Net.VO;
+using Net.VO.Mai2;
+using Net.VO.Mapper;
+
+namespace Net.Packet.Mai2;
+
+internal class PacketGetGameMusicScore : Packet
+{
+    private readonly Action<PacketStatus>? _onError;
+    private int _index;
+    private readonly List<Manager.MusicScore> _downloadMusicScore =
+        Singleton<DLMusicScoreManager>.Instance.GetMusicScoreList();
+    private bool _isDownloadScore;
+
+    public PacketGetGameMusicScore(Action<PacketStatus>? onError = null)
+    {
+        _onError = onError;
+        _isDownloadScore = StartNextDownload();
+    }
+
+    public override PacketState Proc()
+    {
+        if (!_isDownloadScore)
+        {
+            return PacketState.Done;
+        }
+        switch (ProcImpl())
+        {
+            case PacketState.Done:
+            {
+                var netQuery = (NetQuery<GameMusicScoreRequestVO, GameMusicScoreResponseVO>)Query;
+                _downloadMusicScore[_index]
+                    .SetScoreData(netQuery.Response!.GameMusicScore.ScoreData);
+                _index++;
+                _isDownloadScore = StartNextDownload();
+                break;
+            }
+            case PacketState.Error:
+                _onError?.Invoke(Status);
+                break;
+            case PacketState.Ready:
+            case PacketState.Process:
+            case PacketState.RetryWait:
+            case PacketState.Dialog:
+                break;
+            default:
+                throw new ArgumentOutOfRangeException();
+        }
+        return State;
+    }
+
+    private bool StartNextDownload()
+    {
+        while (_index < _downloadMusicScore.Count)
+        {
+            var musicScore = _downloadMusicScore[_index];
+            if (
+                musicScore.IsDownloaded
+                || !Singleton<EventManager>.Instance.IsOpenEvent(musicScore.EventID)
+            )
+            {
+                _index++;
+                continue;
+            }
+
+            Create(GetNetQuery(musicScore));
+            return true;
+        }
+
+        return false;
+    }
+
+    private static NetQuery<GameMusicScoreRequestVO, GameMusicScoreResponseVO> GetNetQuery(
+        Manager.MusicScore musicScore
+    ) => new("GetGameMusicScoreApi") { Request = GameMusicScoreMapper.ToRequestVO(musicScore) };
+}
