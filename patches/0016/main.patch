-
-    private NetQuery<GameMusicScoreRequestVO, GameMusicScoreResponseVO> GetNetQuery(
-        int id,
-        int level,
-        int type
-    )
-    {
-        NetQuery<GameMusicScoreRequestVO, GameMusicScoreResponseVO> netQuery = new NetQuery<
-            GameMusicScoreRequestVO,
