diff --git a/src/SinmaiLib/Net/NetHttpClient.cs b/src/SinmaiLib/Net/NetHttpClient.cs
index ea173c5..a6acfd4 100644
--- a/src/SinmaiLib/Net/NetHttpClient.cs
+++ b/src/SinmaiLib/Net/NetHttpClient.cs
@@ -56,7 +56,7 @@ internal class NetHttpClient : IDisposable
 
     public string Error { get; private set; } = "";
 
-    public int HttpStatus { get; private set; } = -1;
+    public HttpStatusCode? HttpStatus { get; private set; }
 
     public byte[] ResponseData { get; private set; } = [];
 
@@ -151,9 +151,6 @@ public Task<bool> RequestAsync(
         CancellationToken cancellationToken = default
     ) => RequestAsync(data, userAgent, HttpMethod.Post, cancellationToken);
 
-    public Task<bool> RequestAsync(CancellationToken cancellationToken = default) =>
-        RequestAsync([], string.Empty, HttpMethod.Post, cancellationToken);
-
     private async Task<bool> RunRequestAsync(
         byte[] data,
         string userAgent,
@@ -198,7 +195,7 @@ CancellationToken cancellationToken
                 HttpCompletionOption.ResponseHeadersRead,
                 timeout.Token
             );
-            HttpStatus = (int)response.StatusCode;
+            HttpStatus = response.StatusCode;
             if (!response.IsSuccessStatusCode)
             {
                 Cookie = new CookieCollection();
@@ -242,7 +239,7 @@ private void ResetStatus()
     {
         ErrorException = null;
         ErrorKind = NetErrorKind.None;
-        HttpStatus = -1;
+        HttpStatus = null;
         Error = string.Empty;
         ResponseData = [];
     }
