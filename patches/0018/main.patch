+using System;
+using System.Collections.Generic;
+using System.Linq;
+using Net.VO;
+using Net.VO.Mai2;
+
+namespace Net.Packet.Mai2;
+
+internal class PacketGetUserCard : Packet
+{
+    private readonly Action<UserCard[]> _onDone;
+    private readonly Action<PacketStatus>? _onError;
+    private readonly List<UserCardResponseVO> _responseVOList = [];
+
+    public PacketGetUserCard(
+        ulong userId,
+        Action<UserCard[]> onDone,
+        Action<PacketStatus>? onError = null
+    )
+    {
+        _onDone = onDone;
+        _onError = onError;
+        ResetRetryCountAtStart();
+        Create(GetNetQuery(userId, 0));
+    }
+
+    public override PacketState Proc()
+    {
+        switch (ProcImpl())
+        {
+            case PacketState.Done:
+            {
+                if (IsRetryCountOverAtDownload())
+                {
+                    AddUserDataDownloadError();
+                    _onError?.Invoke(PacketStatus.ErrorTimeout);
+                    break;
+                }
+                var netQuery = (NetQuery<UserCardRequestVO, UserCardResponseVO>)Query;
+                _responseVOList.Add(netQuery.Response!);
+                if (netQuery.Response!.NextIndex != 0)
+                {
+                    Create(GetNetQuery(netQuery.Response.UserId, netQuery.Response.NextIndex));
+                    break;
+                }
+                _onDone([.. _responseVOList.SelectMany(i => i.UserCardList)]);
+                break;
+            }
+            case PacketState.Error:
+                _onError?.Invoke(Status);
+                break;
+            case PacketState.Ready:
+            case PacketState.Process:
+            case PacketState.RetryWait:
+            case PacketState.Dialog:
+                break;
+            default:
+                throw new ArgumentOutOfRangeException();
+        }
+        return State;
+    }
+
+    private static NetQuery<UserCardRequestVO, UserCardResponseVO> GetNetQuery(
+        ulong userId,
+        int nextIndex
+    ) =>
+        new("GetUserCardApi", userId)
+        {
+            Request = new UserCardRequestVO { UserId = userId, NextIndex = nextIndex },
+        };
+}
