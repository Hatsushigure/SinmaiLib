+using System;
+using System.Collections.Generic;
+using System.Linq;
+using Net.VO;
+using Net.VO.Mai2;
+
+namespace Net.Packet.Mai2;
+
+internal class PacketGetUserFavoriteItem : Packet
+{
+    private readonly Action<UserFavoriteItem[]> _onDone;
+    private readonly Action<PacketStatus>? _onError;
+    private readonly List<UserFavoriteItemResponseVO> _responseVOList = [];
+    private readonly bool _isAllFavoriteItem;
+
+    public PacketGetUserFavoriteItem(
+        ulong userId,
+        FavoriteItemKind kind,
+        bool isAllFavoriteItem,
+        Action<UserFavoriteItem[]> onDone,
+        Action<PacketStatus>? onError = null
+    )
+    {
+        _onDone = onDone;
+        _onError = onError;
+        _isAllFavoriteItem = isAllFavoriteItem;
+        Create(GetNetQuery(userId, kind, 0, _isAllFavoriteItem));
+    }
+
+    public override PacketState Proc()
+    {
+        switch (ProcImpl())
+        {
+            case PacketState.Done:
+            {
+                var netQuery =
+                    (NetQuery<UserFavoriteItemRequestVO, UserFavoriteItemResponseVO>)Query;
+                _responseVOList.Add(netQuery.Response!);
+                if (netQuery.Response!.NextIndex != 0L)
+                {
+                    Create(
+                        GetNetQuery(
+                            netQuery.Response.UserId,
+                            netQuery.Response.Kind,
+                            0uL,
+                            _isAllFavoriteItem
+                        )
+                    );
+                    break;
+                }
+                _onDone([.. _responseVOList.SelectMany(i => i.UserFavoriteItemList)]);
+                break;
+            }
+            case PacketState.Error:
+                _onError?.Invoke(Status);
+                break;
+            case PacketState.Ready:
+            case PacketState.Process:
+            case PacketState.RetryWait:
+            case PacketState.Dialog:
+                break;
+            default:
+                throw new ArgumentOutOfRangeException();
+        }
+        return State;
+    }
+
+    private static NetQuery<UserFavoriteItemRequestVO, UserFavoriteItemResponseVO> GetNetQuery(
+        ulong userId,
+        FavoriteItemKind kind,
+        ulong nextIndex,
+        bool isAllFavoriteItem
+    ) =>
+        new("GetUserFavoriteItemApi", userId)
+        {
+            Request = new UserFavoriteItemRequestVO
+            {
+                UserId = userId,
+                Kind = kind,
+                NextIndex = nextIndex,
+                IsAllFavoriteItem = isAllFavoriteItem,
+            },
+        };
+}
