+using System.Security.Cryptography;
+using MAI2.Util;
+
+namespace Net;
+
+internal class CipherAes : Singleton<CipherAes>
+{
+    private const int BlockSize = 128;
+    private const int KeySize = 256;
+    private static readonly byte[] AesKey = [.. "FKM2JX:VjZNK6hc:A0<JU:i5oR7LA]9W"u8];
+    private static readonly byte[] AesIV = [.. "F>;24DjU9W6ZsRH["u8];
+
+    public static byte[] Encrypt(byte[] data)
+    {
+        using var aes = Aes.Create();
+        aes.KeySize = KeySize;
+        aes.BlockSize = BlockSize;
+        aes.Mode = CipherMode.CBC;
+        aes.Key = AesKey;
+        aes.IV = AesIV;
+        aes.Padding = PaddingMode.PKCS7;
+        using var encryptor = aes.CreateEncryptor();
+        return encryptor.TransformFinalBlock(data, 0, data.Length);
+    }
+
+    public static byte[] Decrypt(byte[] encryptData)
+    {
+        using var aes = Aes.Create();
+        aes.KeySize = KeySize;
+        aes.BlockSize = BlockSize;
+        aes.Mode = CipherMode.CBC;
+        aes.Key = AesKey;
+        aes.IV = AesIV;
+        aes.Padding = PaddingMode.PKCS7;
+        var encryptor = aes.CreateDecryptor();
+        return encryptor.TransformFinalBlock(encryptData, 0, encryptData.Length);
+    }
+}
