+using System;
+using AMDaemon.Allnet;
+using Manager;
+using Net.VO;
+using Net.VO.Mai2;
+
+namespace Net.Packet.Mai2;
+
+internal class PacketUploadUserPortrait : Packet
+{
+    private const int ChunkSize = 10240;
+    private readonly Action<int> _onDone;
+    private readonly Action<PacketStatus>? _onError;
+    private readonly byte[] _source;
+    private readonly int _chunkLength;
+    private readonly string _fileName;
+    private readonly string _uploadDate = TimeManager.GetNowDateString();
+    private int _currentChunkIndex;
+
+    public PacketUploadUserPortrait(
+        ulong userId,
+        string fileName,
+        byte[] source,
+        Action<int> onDone,
+        Action<PacketStatus>? onError = null
+    )
+    {
+        _onDone = onDone;
+        _onError = onError;
+        _source = source;
+        _fileName = fileName;
+        _chunkLength = _source.Length / ChunkSize + (_source.Length % ChunkSize != 0 ? 1 : 0);
+        Create(GetNetQuery(userId));
+        _currentChunkIndex++;
+    }
+
+    public override PacketState Proc()
+    {
+        switch (ProcImpl())
+        {
+            case PacketState.Done:
+            {
+                var netQuery = (NetQuery<UploadUserPortraitRequestVO, UpsertResponseVO>)Query;
+                if (_currentChunkIndex < _chunkLength)
+                {
+                    Create(GetNetQuery(netQuery.UserId));
+                    _currentChunkIndex++;
+                }
+                else
+                {
+                    _onDone(netQuery.Response!.ReturnCode);
+                }
+                break;
+            }
+            case PacketState.Error:
+                _onError?.Invoke(Status);
+                break;
+        }
+        return State;
+    }
+
+    private string GetChunkDataBase64(int chunkIndex) =>
+        Convert.ToBase64String(
+            _source.AsSpan(
+                chunkIndex * ChunkSize,
+                Math.Min(ChunkSize, _source.Length - chunkIndex * ChunkSize)
+            )
+        );
+
+    private NetQuery<UploadUserPortraitRequestVO, UpsertResponseVO> GetNetQuery(ulong userId) =>
+        new("UploadUserPortraitApi", userId)
+        {
+            Request = new UploadUserPortraitRequestVO
+            {
+                UserPortrait = new UserPortrait
+                {
+                    UserId = userId,
+                    DivNumber = _currentChunkIndex,
+                    DivLength = _chunkLength,
+                    DivData = GetChunkDataBase64(_currentChunkIndex),
+                    PlaceId = (int)Auth.LocationId,
+                    ClientId = AMDaemon.System.KeychipId.ShortValue,
+                    UploadDate = _uploadDate,
+                    FileName = _fileName,
+                },
+            },
+        };
+}
