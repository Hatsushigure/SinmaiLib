+namespace Net.VO;
+
+internal class NetQuery<TRequest, TResponse>(string api, ulong userId = 0uL) : INetQuery
+    where TRequest : class, ISerializable<TRequest>
+    where TResponse : class, ISerializable<TResponse>
+{
+    public string Api { get; } = api + "MaimaiChn";
+
+    public ulong UserId { get; } = userId;
+
+    public required TRequest Request { get; init; }
+
+    public TResponse? Response { get; private set; }
+
+    public string GetRequest() => Request.Serialize();
+
+    public bool SetResponse(string str)
+    {
+        if (string.IsNullOrEmpty(str))
+        {
+            return false;
+        }
+
+        Response = ISerializable<TResponse>.Deserialize(str);
+        return true;
+    }
+}
