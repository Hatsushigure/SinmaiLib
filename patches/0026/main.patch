+using System;
+using Net.VO;
+using Net.VO.Mai2;
+
+namespace Net.Packet.Mai2;
+
+internal class PacketGetUserGhost : Packet
+{
+    private readonly Action<UserGhost[]> _onDone;
+    private readonly Action<PacketStatus>? _onError;
+
+    public PacketGetUserGhost(
+        ulong userId,
+        Action<UserGhost[]> onDone,
+        Action<PacketStatus>? onError = null
+    )
+    {
+        _onDone = onDone;
+        _onError = onError;
+        var netQuery = new NetQuery<UserGhostRequestVO, UserGhostResponseVO>(
+            "GetUserGhostApi",
+            userId
+        )
+        {
+            Request = new UserGhostRequestVO { UserId = userId },
+        };
+        Create(netQuery);
+    }
+
+    public override PacketState Proc()
+    {
+        switch (ProcImpl())
+        {
+            case PacketState.Done:
+            {
+                var netQuery = (NetQuery<UserGhostRequestVO, UserGhostResponseVO>)Query;
+                _onDone(netQuery.Response!.UserGhostList);
+                break;
+            }
+            case PacketState.Error:
+                _onError?.Invoke(Status);
+                break;
+            case PacketState.Ready:
+            case PacketState.Process:
+            case PacketState.RetryWait:
+            case PacketState.Dialog:
+                break;
+            default:
+                throw new ArgumentOutOfRangeException();
+        }
+        return State;
+    }
+}
